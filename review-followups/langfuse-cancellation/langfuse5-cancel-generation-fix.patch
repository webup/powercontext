+@pytest.mark.parametrize("error_message", ["", "requested cancellation"])
+def test_cancelled_llm_error_preserves_unknown_cost_and_sibling_runs(
+    langfuse_memory_client, find_spans, get_span, error_message
+):
+    handler = CallbackHandler()
+    (
+        root,
+        cancelled_branch,
+        sibling_branch,
+        cancelled_llm,
+        other_cancelled_llm,
+        sibling_llm,
+    ) = (uuid4() for _ in range(6))
+    with trace_api.use_span(trace_api.get_current_span(), end_on_exit=False):
+        handler.on_chain_start({"name": "root"}, {}, run_id=root)
+        handler.on_chain_start(
+            {"name": "cancelled-branch"},
+            {},
+            run_id=cancelled_branch,
+            parent_run_id=root,
+        )
+        handler.on_chat_model_start(
+            {"name": "cancelled-generation"},
+            [[HumanMessage(content="cancel")]],
+            run_id=cancelled_llm,
+            parent_run_id=cancelled_branch,
+            invocation_params={},
+        )
+        handler.on_llm_new_token(
+            "partial", run_id=cancelled_llm, parent_run_id=cancelled_branch
+        )
+        handler.on_chat_model_start(
+            {"name": "other-cancelled-generation"},
+            [[HumanMessage(content="cancel together")]],
+            run_id=other_cancelled_llm,
+            parent_run_id=cancelled_branch,
+            invocation_params={},
+        )
+        handler.on_chain_start(
+            {"name": "sibling-branch"}, {}, run_id=sibling_branch, parent_run_id=root
+        )
+        handler.on_chat_model_start(
+            {"name": "sibling-generation"},
+            [[HumanMessage(content="continue")]],
+            run_id=sibling_llm,
+            parent_run_id=sibling_branch,
+            invocation_params={},
+        )
+        sibling_span = trace_api.get_current_span()
+        handler.on_llm_error(
+            asyncio.CancelledError(error_message),
+            run_id=cancelled_llm,
+            parent_run_id=cancelled_branch,
+        )
+        assert sibling_span.is_recording()
+        assert cancelled_llm not in handler._updated_completion_start_time_memo
+        handler.on_llm_error(
+            asyncio.CancelledError(),
+            run_id=other_cancelled_llm,
+            parent_run_id=cancelled_branch,
+        )
+        handler.on_chain_error(
+            asyncio.CancelledError(), run_id=cancelled_branch, parent_run_id=root
+        )
+        # A delayed terminal callback must not publish the generation twice.
+        handler.on_llm_error(
+            asyncio.CancelledError(),
+            run_id=cancelled_llm,
+            parent_run_id=cancelled_branch,
+        )
+        handler.on_llm_end(
+            LLMResult(
+                generations=[[ChatGeneration(message=AIMessage(content="late result"))]]
+            ),
+            run_id=cancelled_llm,
+            parent_run_id=cancelled_branch,
+        )
+        handler.on_llm_end(
+            LLMResult(
+                generations=[[ChatGeneration(message=AIMessage(content="done"))]]
+            ),
+            run_id=sibling_llm,
+            parent_run_id=sibling_branch,
+        )
+        handler.on_chain_end({}, run_id=sibling_branch, parent_run_id=root)
+        handler.on_chain_error(asyncio.CancelledError(), run_id=root)
+
+    langfuse_memory_client.flush()
+    assert len(find_spans("cancelled-generation")) == 1
+    assert len(find_spans("other-cancelled-generation")) == 1
+    assert len(find_spans("sibling-generation")) == 1
+    assert get_span("sibling-generation").status.status_code.name == "UNSET"
+    for name in ("cancelled-generation", "other-cancelled-generation"):
+        span = get_span(name)
+        assert span.status.status_code.name == "ERROR"
+        assert span.attributes[LangfuseOtelSpanAttributes.OBSERVATION_LEVEL] == "ERROR"
+        expected_status = (
+            "CancelledError: " + error_message
+            if name == "cancelled-generation" and error_message
+            else "CancelledError"
+        )
+        assert (
+            span.attributes[LangfuseOtelSpanAttributes.OBSERVATION_STATUS_MESSAGE]
+            == expected_status
+        )
+        assert LangfuseOtelSpanAttributes.OBSERVATION_OUTPUT not in span.attributes
+        assert (
+            LangfuseOtelSpanAttributes.OBSERVATION_USAGE_DETAILS not in span.attributes
+        )
+        assert (
+            LangfuseOtelSpanAttributes.OBSERVATION_COST_DETAILS not in span.attributes
+        )
+    assert not handler._runs
+    assert not handler._context_tokens
+
