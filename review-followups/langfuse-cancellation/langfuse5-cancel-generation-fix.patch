+def test_cancelled_async_model_stream_exports_generation_without_inventing_cost(
+    langfuse_memory_client, get_span
+):
+    handler = CallbackHandler()
+    handler.run_inline = True
+    interrupted = {}
+
+    async def run():
+        started = asyncio.Event()
+
+        class StreamingChatModel(BaseChatModel):
+            @property
+            def _llm_type(self):
+                return "local-stream-cancellation-test"
+
+            def _generate(self, messages, stop=None, run_manager=None, **kwargs):
+                raise NotImplementedError
+
+            async def _astream(self, messages, stop=None, run_manager=None, **kwargs):
+                try:
+                    yield ChatGenerationChunk(message=AIMessageChunk(content="partial"))
+                    await asyncio.Future()
+                except asyncio.CancelledError:
+                    interrupted["at"] = time.time_ns()
+                    raise
+
+        async def consume():
+            with langfuse_memory_client.start_as_current_observation(
+                name="stream-parent"
+            ):
+                parent = trace_api.get_current_span()
+                try:
+                    with trace_api.use_span(
+                        parent,
+                        end_on_exit=False,
+                        record_exception=False,
+                        set_status_on_exception=False,
+                    ):
+                        async for _ in StreamingChatModel().astream(
+                            [HumanMessage(content="stream")],
+                            config={
+                                "callbacks": [handler],
+                                "run_name": "stream-generation",
+                            },
+                        ):
+                            started.set()
+                finally:
+                    assert trace_api.get_current_span() is parent
+                    assert parent.is_recording()
+
+        task = asyncio.create_task(consume())
+        await started.wait()
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+
+    asyncio.run(run())
+    langfuse_memory_client.flush()
+    span = get_span("stream-generation")
+    _assert_parent_child(get_span("stream-parent"), span)
+    assert span.end_time >= interrupted["at"]
+    assert span.status.status_code.name == "ERROR"
+    assert (
+        span.attributes[LangfuseOtelSpanAttributes.OBSERVATION_STATUS_MESSAGE]
+        == "CancelledError"
+    )
+    assert LangfuseOtelSpanAttributes.OBSERVATION_OUTPUT not in span.attributes
+    assert LangfuseOtelSpanAttributes.OBSERVATION_USAGE_DETAILS not in span.attributes
+    assert LangfuseOtelSpanAttributes.OBSERVATION_COST_DETAILS not in span.attributes
+    assert not handler._updated_completion_start_time_memo
+    assert not handler._runs
+    assert not handler._context_tokens
 
 
