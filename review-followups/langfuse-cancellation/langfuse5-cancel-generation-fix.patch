+def test_cancelled_llm_error_preserves_recorded_partial_facts(
+    langfuse_memory_client, get_span, json_attr
+):
+    handler = CallbackHandler()
+    run_id = uuid4()
+    with trace_api.use_span(trace_api.get_current_span(), end_on_exit=False):
+        handler.on_chat_model_start(
+            {"name": "partial-generation"},
+            [[HumanMessage(content="stream")]],
+            run_id=run_id,
+            invocation_params={},
+        )
+        langfuse_memory_client.update_current_generation(
+            output="observed partial text",
+            usage_details={"input": 3},
+            cost_details={"input": 0.1},
+        )
+        handler.on_llm_error(asyncio.CancelledError(), run_id=run_id)
+    langfuse_memory_client.flush()
+    span = get_span("partial-generation")
+    assert (
+        span.attributes[LangfuseOtelSpanAttributes.OBSERVATION_OUTPUT]
+        == "observed partial text"
+    )
+    assert json_attr(span, LangfuseOtelSpanAttributes.OBSERVATION_USAGE_DETAILS) == {
+        "input": 3
+    }
+    assert json_attr(span, LangfuseOtelSpanAttributes.OBSERVATION_COST_DETAILS) == {
+        "input": 0.1
+    }
+
